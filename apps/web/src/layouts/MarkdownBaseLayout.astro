---
import { metaConfig } from "../config/meta.ts";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;

const title = frontmatter.title ?? metaConfig.default.title;
const description = frontmatter.description ?? metaConfig.default.description;
---

<BaseLayout title={title} description={description}>
    <div class="font-caslon p-4 mx-auto max-w-4xl lg:max-w-5xl md:px-16 [&_h1]:mt-10 [&_h1]:mb-4 [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:my-4 [&_table]:my-4 [&_table]:border [&_table]:border-midgrey [&_th]:border [&_th]:border-midgrey [&_th]:px-4 [&_th]:py-2 [&_td]:border [&_td]:border-midgrey [&_td]:px-4 [&_td]:py-2 [&_ul]:list-disc [&_ul]:list-inside">
        <slot />
    </div>
</BaseLayout>
