---
import ContactSection from "../components/ContactSection.astro";
import { HeroSection } from "../components/HeroSection";
import { metaConfig } from "../config/meta.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={metaConfig.default.title} description={metaConfig.default.description}>
    <HeroSection />
    <div class="animate-fade-in-up [animation-delay:500ms]">
        <ContactSection />
    </div>
</BaseLayout>
